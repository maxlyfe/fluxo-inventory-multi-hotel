# ─────────────────────────────────────────────────────────────────────────────
# Evolution API: variáveis do docker compose
# Copie para .env na mesma pasta e preencha. NÃO versione o .env.
# ─────────────────────────────────────────────────────────────────────────────

# Domínio público que aponta para o IP desta VPS (registro A no DNS).
# O Caddy emite o certificado TLS para ele automaticamente.
EVOLUTION_DOMAIN=evolution.seudominio.com.br

# E-mail usado pelo Let's Encrypt para avisos de expiração.
ACME_EMAIL=compras@meridianahoteles.com

# Chave mestra da API. Vai no campo "API Key" da tela de Integração WhatsApp.
# Gere com: openssl rand -hex 32
EVOLUTION_API_KEY=troque-esta-chave

# Senha do Postgres interno. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha
